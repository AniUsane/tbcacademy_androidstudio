<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/mainImage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:src="@drawable/bitmap"
        app:layout_constraintTop_toTopOf="parent"/>

    <androidx.appcompat.widget.AppCompatImageButton
        android:id="@+id/locationIcon"
        android:layout_width="12dp"
        android:layout_height="15dp"
        android:layout_marginTop="40dp"
        android:layout_marginLeft="33dp"
        android:src="@drawable/location_img"
        app:layout_constraintTop_toTopOf="@+id/mainImage"
        app:layout_constraintLeft_toLeftOf="@+id/mainImage"
        />

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/location"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="9dp"
        android:textColor="@color/white"
        android:layout_marginTop="40dp"
        app:layout_constraintTop_toTopOf="@+id/mainImage"
        app:layout_constraintLeft_toRightOf="@+id/locationIcon"
        />

    <androidx.appcompat.widget.AppCompatImageButton
        android:id="@+id/likesIcon"
        android:layout_width="12dp"
        android:layout_height="15dp"
        android:layout_marginRight="9dp"
        android:src="@drawable/flame"
        android:layout_marginTop="40dp"
        app:layout_constraintTop_toTopOf="@+id/mainImage"
        app:layout_constraintRight_toLeftOf="@+id/likes"
        />

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/likes"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginRight="32dp"
        android:textColor="@color/white"
        android:layout_marginTop="40dp"
        app:layout_constraintTop_toTopOf="@+id/mainImage"
        app:layout_constraintRight_toRightOf="@+id/mainImage"
        />

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/imageTitle"
        android:layout_width="190dp"
        android:layout_height="wrap_content"
        android:text="Natural walk to the top"
        android:textColor="@color/white"
        android:textSize="32dp"
        android:layout_marginBottom="97dp"
        android:layout_marginLeft="30dp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="@+id/mainImage"
        app:layout_constraintLeft_toLeftOf="@+id/mainImage"
        />

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/price"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="$120"
        android:textColor="@color/white"
        android:layout_marginTop="14sp"
        android:textStyle="bold"
        app:layout_constraintTop_toBottomOf="@+id/imageTitle"
        app:layout_constraintLeft_toLeftOf="@+id/imageTitle"
        />

    <RatingBar
        android:id="@+id/rating"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginRight="32dp"
        android:numStars="5"
        android:stepSize="0.5"
        android:scaleX="0.5"
        android:scaleY="0.5"
        android:progressTint="@android:color/white"
        android:secondaryProgressTint="@android:color/white"
        android:progressBackgroundTint="@android:color/darker_gray"
        app:layout_constraintTop_toBottomOf="@+id/imageTitle"
        app:layout_constraintRight_toRightOf="@+id/mainImage"
        />

</androidx.constraintlayout.widget.ConstraintLayout>